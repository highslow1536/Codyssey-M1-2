# 이 파일을 .env로 복사하고 실제 값을 입력하세요. .env와 서버 자격 JSON은 커밋하지 않습니다.
# 실제 시세·뉴스·시장 심리 / Firestore / 필수 API / OpenAI 채팅 / 바닐라 웹 UI.
APP_ENV=development

# Firebase Console에서 Firestore (default) DB와 Authentication을 준비하세요.
FIREBASE_PROJECT_ID=
# 아래 두 가지 중 하나만 설정합니다. 로컬은 JSON 경로, Render는 한 줄 JSON을 권장합니다.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Authentication 사용자의 UID. 여러 값은 쉼표로 구분합니다. 비우면 API 접근을 허용하지 않습니다.
ALLOWED_USER_UIDS=
# 실제 수집 CLI·Discord 워커의 소유 UID: 위 허용 목록 중 하나여야 합니다.
JOB_OWNER_UID=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI 프로젝트 키와 사용 가능한 모델 ID. 비우면 채팅은 503, 뉴스는 제목·요약 발췌 모드입니다.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=1200
MAX_TOOL_CALLS=5
MAX_TOOL_ROUNDS=3
CHAT_LEASE_SECONDS=300

# 로컬 에뮬레이터 전용. 클라우드 연결·Render 배포 시 반드시 비우세요.
# 테스트에서는 demo- 접두 프로젝트와 APP_ENV=test를 사용합니다. 인증 우회 모드는 없습니다.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# 실제 뉴스 공급원. Naver 개발자센터에서 검색 API를, Finnhub에서 무료 API 키를 발급합니다.
# 비우면 해당 시장 뉴스는 news_not_configured 상태입니다. Yahoo·CNN은 키가 필요 없습니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
FINNHUB_API_KEY=
NEWS_CACHE_MINUTES=30
SENTIMENT_CACHE_MINUTES=30
ANALYSIS_CACHE_MINUTES=30

# Discord 일반 텍스트 채널 > 연동 > 웹후크 URL(서버 전용 비밀값).
# https://discord.com/api/webhooks/ID/TOKEN 형식. 브라우저에는 전달하지 않습니다.
# 예약/수동 전송은 python -m jobs.tick --loop 워커와 JOB_OWNER_UID 설정이 필요합니다.
DISCORD_WEBHOOK_URL=

# 가격 알림: 정규장 완성 5분 봉. worker가 켜져 있는 동안 종목별로 수집합니다.
# 1~60분, 기본 5분. 이 값과 별도로 Yahoo 한국 시세에는 약 20분 지연이 있습니다.
DATA_POLL_MINUTES=5

# 다음 단계: 외부 MCP 서버.
MCP_OWNER_UID=

# 바닐라 프런트 빌드의 공개 설정. 아래 세 값만 config.js에 포함합니다.
# 로컬은 http://localhost:8000, Vercel은 Render API의 https 주소.
API_BASE_URL=http://localhost:8000
# Firebase Console > 프로젝트 설정 > 일반 > 내 앱 > 웹 앱의 공개 config 객체를 JSON 한 줄로 입력.
# 예: {"apiKey":"...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","appId":"..."}
# 서비스 계정 JSON이나 OpenAI 키를 여기에 넣지 마세요.
FIREBASE_WEB_CONFIG_JSON=
# 로컬 인증 에뮬레이터 전용(예: http://127.0.0.1:9099). 클라우드 연결·Vercel에서는 비우세요.
FRONTEND_AUTH_EMULATOR_URL=
