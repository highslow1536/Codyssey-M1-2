# 이 파일을 .env로 복사하고 실제 값을 입력하세요. .env와 서버 자격 JSON은 커밋하지 않습니다.
# 실제 시세·뉴스·시장 심리 / Firestore / 필수 API / OpenAI 채팅 / 바닐라 웹 UI.
# 배포 절차·서비스별 입력 위치·Firebase 도메인: docs/deployment.md
# Vercel에는 맨 아래 공개 설정 2개만, 서버용 값은 Render API/워커에 입력합니다.
# Render는 APP_ENV=production. 시작 시 jobs.check_config가 오프라인 설정 검사를 수행합니다.
APP_ENV=development

# Firebase Console에서 Firestore (default) DB와 Authentication을 준비하세요.
FIREBASE_PROJECT_ID=
# 아래 두 가지 중 하나만 설정합니다. 로컬은 JSON 경로를 사용합니다.
# Render는 Secret File 경로 또는 한 줄 JSON을 사용합니다. 실제 배포 구성은 docs/deployment.md.
# JSON의 project_id도 FIREBASE_PROJECT_ID와 같아야 합니다. 실제 PEM 줄바꿈은 JSON의 \n 형태입니다.
# Render 사전 검사에는 명시적인 서비스 계정이 필요합니다(자동 ADC 탐색에 의존하지 않음).
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Authentication 사용자의 UID. 여러 값은 쉼표로 구분합니다. 비우면 API 접근을 허용하지 않습니다.
ALLOWED_USER_UIDS=
# 실제 수집 CLI·Discord 워커의 소유 UID: 위 허용 목록 중 하나여야 합니다.
# Discord를 사용할 때 API와 워커에 동일하게 입력하세요. 워커는 이 소유자의 작업만 처리합니다.
JOB_OWNER_UID=
# Render API는 https://your-app.vercel.app 형태의 정확한 오리진만 쉼표로 나열합니다.
# 끝의 /·경로·와일드카드는 제외합니다. 프리뷰 도메인은 필요할 때만 개별 등록합니다.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI 프로젝트 키와 사용 가능한 모델 ID. 비우면 채팅은 503, 뉴스는 제목·요약 발췌 모드입니다.
OPENAI_API_KEY=
OPENAI_MODEL=
# openai: 공식 Responses API / codyssey: Codyssey 가상 키로 Chat Completions 호출
OPENAI_PROVIDER=openai
CODYSSEY_API_KEY=
OPENAI_MAX_OUTPUT_TOKENS=1200
MAX_TOOL_CALLS=5
MAX_TOOL_ROUNDS=3
CHAT_LEASE_SECONDS=300

# 로컬 에뮬레이터 전용. 클라우드 연결·Render 배포 시 반드시 비우세요.
# 테스트에서는 demo- 접두 프로젝트와 APP_ENV=test를 사용합니다. 인증 우회 모드는 없습니다.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# 실제 뉴스 공급원. 신규 키는 NAVER Cloud의 NAVER API HUB > 검색 API에서 발급합니다.
# 2026-07-31 이전 개발자센터 키만 legacy로 설정합니다(2027-06-30 종료 예정).
# API HUB와 legacy는 주소·인증 헤더가 다르며 자동 전환하지 않습니다.
# Finnhub에서는 무료 API 키를 발급합니다.
# 비우면 해당 시장 뉴스는 news_not_configured 상태입니다. Yahoo·CNN은 키가 필요 없습니다.
NAVER_API_MODE=api_hub
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
FINNHUB_API_KEY=
NEWS_CACHE_MINUTES=30
SENTIMENT_CACHE_MINUTES=30
ANALYSIS_CACHE_MINUTES=30

# Discord 일반 텍스트 채널 > 연동 > 웹후크 URL(서버 전용 비밀값).
# https://discord.com/api/webhooks/ID/TOKEN 형식. 브라우저에는 전달하지 않습니다.
# 예약/수동 전송은 python -m jobs.tick --loop 워커와 JOB_OWNER_UID 설정이 필요합니다.
# 60초 루프가 예약·전송 큐를 확인하며, DATA_POLL_MINUTES는 별도 시세 수집 주기입니다.
DISCORD_WEBHOOK_URL=

# 가격 알림: 정규장 완성 5분 봉. worker가 켜져 있는 동안 종목별로 수집합니다.
# true이면 FastAPI가 실행되는 동안 가격 감시와 전송을 수행합니다. Render Free 절전 중에는 멈춥니다.
PRICE_ALERTS_IN_API=false
# 1~60분, 기본 5분. 이 값과 별도로 Yahoo 한국 시세에는 약 20분 지연이 있습니다.
DATA_POLL_MINUTES=5

# 로컬 stdio MCP 서버의 고정 사용자. ALLOWED_USER_UIDS에 포함된 UID여야 합니다.
# MCP는 서버용 Firebase 자격을 사용합니다. 자격 파일은 절대 경로로 지정하세요.
# python -m mcp_adapter.server --env-file /absolute/path/to/.env
# 외부 채팅 앱 설정과 도구 목록: docs/mcp.md, examples/mcp-host.json
MCP_OWNER_UID=
# 알림 생성·수정·초기화의 MCP 폼 확인 대기(30~300초). 지원하지 않는 앱은 조회만 가능.
MCP_CONFIRMATION_TIMEOUT_SECONDS=120

# 바닐라 프런트 빌드의 공개 설정. 아래 세 값만 config.js에 포함합니다.
# VERCEL_ENV=production/preview에서는 HTTPS API와 Firebase 설정 필수, 에뮬레이터 사용 금지.
# VERCEL_ENV는 Vercel이 제공하는 빌드 구분값이며 config.js에는 포함되지 않습니다.
# 로컬은 http://localhost:8000, Vercel은 Render API의 https 주소.
API_BASE_URL=http://localhost:8000
# Firebase Console > 프로젝트 설정 > 일반 > 내 앱 > 웹 앱의 공개 config 객체를 JSON 한 줄로 입력.
# 예: {"apiKey":"...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","appId":"..."}
# 서비스 계정 JSON이나 OpenAI 키를 여기에 넣지 마세요.
# authDomain은 기본 your-project.firebaseapp.com 유지. Vercel 호스트는 Auth 승인 도메인에 등록.
FIREBASE_WEB_CONFIG_JSON=
# 로컬 인증 에뮬레이터 전용(예: http://127.0.0.1:9099). 클라우드 연결·Vercel에서는 비우세요.
FRONTEND_AUTH_EMULATOR_URL=
